<Window x:Class="ScreenTranslator.Desktop.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Translator — Resultado"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MinWidth="360">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8"
                Background="#CC202020" CornerRadius="6"
                MouseLeftButtonDown="OnButtonBarMouseLeftButtonDown">
            <WrapPanel>
                <Button x:Name="CopyTextButton" Content="Copiar texto" Padding="10,4" Margin="0,0,6,6" Click="OnCopyTextClick" />
                <Button x:Name="CopyImageButton" Content="Copiar imagem" Padding="10,4" Margin="0,0,6,6" Click="OnCopyImageClick" />
                <Button x:Name="CopyImageWithTranslationButton" Content="Copiar imagem com tradução" Padding="10,4" Margin="0,0,6,6" Click="OnCopyImageWithTranslationClick" />
                <Button x:Name="SaveImageButton" Content="Salvar imagem" Padding="10,4" Margin="0,0,6,6" Click="OnSaveImageClick" />
                <Button x:Name="SaveImageWithTranslationButton" Content="Salvar imagem com tradução" Padding="10,4" Margin="0,0,6,6" Click="OnSaveImageWithTranslationClick" />
                <ToggleButton x:Name="ToggleOverlayButton" Content="Ver original" Padding="10,4" Margin="0,0,6,6" IsChecked="True" Click="OnToggleOverlayClick" />
                <Button x:Name="RecaptureButton" Content="Nova captura" Padding="10,4" Margin="0,0,6,6" Click="OnRecaptureClick" />
                <Button x:Name="CloseButton" Content="Fechar" Padding="10,4" Margin="0,0,0,6" Click="OnCloseClick" />
            </WrapPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ImageHost">
                <Image x:Name="CaptureImage" Stretch="Fill" />
                <Canvas x:Name="OverlayCanvas" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
