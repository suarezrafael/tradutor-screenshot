<Window x:Class="ScreenTranslator.Desktop.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Translator — Resultado"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MinWidth="360">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6"
                Background="#CC202020" CornerRadius="6"
                MouseLeftButtonDown="OnButtonBarMouseLeftButtonDown">
            <WrapPanel>
                <Button x:Name="CopyTextButton" Content="Copiar texto" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,4,4" Click="OnCopyTextClick" />
                <Button x:Name="CopyImageButton" Content="Copiar imagem" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,4,4" Click="OnCopyImageClick" />
                <Button x:Name="CopyImageWithTranslationButton" Content="Copiar imagem com tradução" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,4,4" Click="OnCopyImageWithTranslationClick" />
                <Button x:Name="SaveImageButton" Content="Salvar imagem" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,4,4" Click="OnSaveImageClick" />
                <Button x:Name="SaveImageWithTranslationButton" Content="Salvar imagem com tradução" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,4,4" Click="OnSaveImageWithTranslationClick" />
                <ToggleButton x:Name="ToggleOverlayButton" Content="Ver original" Style="{StaticResource OverlayToggleButtonStyle}" Margin="0,0,4,4" IsChecked="True" Click="OnToggleOverlayClick" />
                <Button x:Name="RecaptureButton" Content="Nova captura" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,4,4" Click="OnRecaptureClick" />
                <Button x:Name="CloseButton" Content="Fechar" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,0,4" Click="OnCloseClick" />
            </WrapPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- Left/Top-aligned, not the default Stretch: a Grid with an explicit Width smaller than
                 its container centers itself in the leftover space under Stretch, which throws off
                 PositionOverCapture's assumption that the image sits at a fixed offset from the
                 window's origin - most visible for a small capture in a window widened by the button
                 bar, especially near the screen's left edge where there's no room to compensate. -->
            <Grid x:Name="ImageHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image x:Name="CaptureImage" Stretch="Fill" />
                <Canvas x:Name="OverlayCanvas" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
