<Window x:Class="ScreenTranslator.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — Screen Translator"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="16" Width="360">
        <TextBlock Text="Idioma de origem padrão" Margin="0,0,0,4" />
        <ComboBox x:Name="SourceLanguageCombo" DisplayMemberPath="DisplayName" Margin="0,0,0,12" />

        <TextBlock Text="Idioma de destino" Margin="0,0,0,4" />
        <ComboBox x:Name="TargetLanguageCombo" DisplayMemberPath="DisplayName" Margin="0,0,0,12" />

        <TextBlock Text="Atalho de captura (ex: Ctrl+Shift+T)" Margin="0,0,0,4" />
        <TextBox x:Name="CaptureHotkeyBox" Margin="0,0,0,12" />

        <TextBlock Text="Atalho para mostrar última tradução" Margin="0,0,0,4" />
        <TextBox x:Name="LastResultHotkeyBox" Margin="0,0,0,12" />

        <TextBlock Text="Tamanho mínimo da fonte da tradução (o tamanho real acompanha o texto original)" Margin="0,0,0,4" TextWrapping="Wrap" />
        <Slider x:Name="FontSizeSlider" Minimum="6" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12" />

        <TextBlock Text="Transparência do fundo da tradução" Margin="0,0,0,4" />
        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" Margin="0,0,0,12" />

        <CheckBox x:Name="StartWithWindowsCheck" Content="Iniciar com o Windows" Margin="0,0,0,8" />
        <CheckBox x:Name="MinimizeToTrayCheck" Content="Manter na bandeja ao minimizar" Margin="0,0,0,8" />
        <CheckBox x:Name="AutoCopyCheck" Content="Copiar tradução automaticamente" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Salvar" Padding="14,4" Margin="0,0,8,0" Click="OnSaveClick" />
            <Button x:Name="CancelButton" Content="Cancelar" Padding="14,4" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
