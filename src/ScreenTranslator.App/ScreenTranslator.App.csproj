<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ScreenTranslator.Domain\ScreenTranslator.Domain.csproj" />
    <ProjectReference Include="..\ScreenTranslator.Application\ScreenTranslator.Application.csproj" />
    <ProjectReference Include="..\ScreenTranslator.Infrastructure\ScreenTranslator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Downloaded by scripts/download-tessdata.ps1; not committed to git, so this glob is empty on a fresh clone. -->
    <None Include="tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" Condition="Exists('tessdata')" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms auto-adds these as implicit global usings, which collide everywhere with the
         WPF types of the same name (Application, MessageBox, Clipboard, FontFamily, Color, ...). We
         only use WinForms for the tray icon and a few Win32-adjacent helpers, so those files add the
         namespace explicitly instead of making it global. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ScreenTranslator</AssemblyName>
    <RootNamespace>ScreenTranslator.Desktop</RootNamespace>
    <!-- WFAC010: WinForms analyzer complains about manifest-based DPI settings, but DPI awareness here
         is intentionally driven by app.manifest (PerMonitorV2) since this is a WPF app using WinForms
         only for the tray icon and monitor enumeration. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

</Project>
