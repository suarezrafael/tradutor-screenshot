<Window x:Class="ScreenTranslator.Desktop.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Translator"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Border Margin="10" Padding="6" Background="#CC202020" CornerRadius="6"
            MouseLeftButtonDown="OnBarMouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="CaptureButton" Content="Capturar" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,8,0" Click="OnCaptureClick" />

            <TextBlock Text="Origem:" Style="{StaticResource OverlayLabelStyle}" Margin="0,0,4,0" />
            <ComboBox x:Name="SourceLanguageCombo" Width="140" DisplayMemberPath="DisplayName"
                      Style="{StaticResource OverlayComboBoxStyle}" Margin="0,0,8,0"
                      SelectionChanged="OnSourceLanguageChanged" />

            <TextBlock Text="Destino:" Style="{StaticResource OverlayLabelStyle}" Margin="0,0,4,0" />
            <ComboBox x:Name="TargetLanguageCombo" Width="140" DisplayMemberPath="DisplayName"
                      Style="{StaticResource OverlayComboBoxStyle}" Margin="0,0,8,0"
                      SelectionChanged="OnTargetLanguageChanged" />

            <Button x:Name="CopyTextButton" Content="Copiar texto" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,4,0" Click="OnCopyTextClick" IsEnabled="False" />
            <Button x:Name="CopyImageButton" Content="Copiar imagem" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,4,0" Click="OnCopyImageClick" IsEnabled="False" />
            <Button x:Name="SettingsButton" Content="Configurações" Style="{StaticResource OverlayButtonStyle}" Margin="0,0,4,0" Click="OnSettingsClick" />
            <Button x:Name="CloseButton" Content="Fechar" Style="{StaticResource OverlayButtonStyle}" Click="OnCloseClick" />
        </StackPanel>
    </Border>
</Window>
