<Window x:Class="ScreenTranslator.Desktop.ProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Translator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Border Background="#EE202020" CornerRadius="8" Padding="24,18">
        <StackPanel MinWidth="200">
            <TextBlock Text="Traduzindo..." Foreground="White" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <ProgressBar IsIndeterminate="True" Height="6" />
        </StackPanel>
    </Border>
</Window>
