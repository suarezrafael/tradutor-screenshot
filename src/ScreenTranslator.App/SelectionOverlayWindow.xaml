<Window x:Class="ScreenTranslator.Desktop.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid>
        <Canvas x:Name="RootCanvas" Background="#66000000">
            <Border x:Name="SelectionBorder"
                    BorderBrush="#2173DB"
                    BorderThickness="2"
                    Background="#332173DB"
                    Visibility="Collapsed" />
            <Border x:Name="HintBorder"
                    Background="#CC1E1E1E"
                    CornerRadius="4"
                    Padding="10,6">
                <TextBlock Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Text="Arraste para selecionar a área. Pressione ESC para cancelar." />
            </Border>
        </Canvas>
    </Grid>
</Window>
